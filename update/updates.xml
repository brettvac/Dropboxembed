<updates>
    <update>
        <name>Dropbox Embed Updates</name>
        <description>Dropbox Embed is a Joomla! plugin that allows you to use the Dropbox Embedder in Joomla! content with a shortcode.</description>
        <element>dropboxembed</element>
        <type>plugin</type>
        <folder>content</folder>
        <version>1.2</version>
        <client>site</client>
        <downloads>
            <downloadurl type="full" format="zip">
                https://github.com/brettvac/dropboxembed/releases/download/1.2/plg_content_dropboxembed.zip
            </downloadurl>
        </downloads>
        <infourl>https://github.com/brettvac/dropboxembed/releases/tag/1.2</infourl>
        <targetplatform name="joomla" version="(5.*)|(6.*)"/>
        <php_minimum>8.1.0</php_minimum>
    </update>
</updates>
